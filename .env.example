# stock-trader — 환경 변수 예시 (커밋용 템플릿, 실 값 절대 기재 금지)
# 사용법: cp .env.example .env.local  →  실 값 채우기
# ⚠️  Docker Compose env_file은 ${VAR} 미확장 → 서비스 URL은 하드코딩 필수 (dev/staging/prod)
APP_ENV=local

# ── DB ──────────────────────────────────────────────────────────────────────────
# local: SQLite (compose 없이 직접실행)
DATABASE_URL=sqlite:///./local.db
DATABASE_URL_SYNC=sqlite:///./local.db
# dev/staging/prod: PostgreSQL (Docker Compose 내부)
# POSTGRES_USER=app
# POSTGRES_PASSWORD=<change-me>
# POSTGRES_DB=stock_trader
# DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/stock_trader
# DATABASE_URL_SYNC=postgresql://app:app@postgres:5432/stock_trader

# ── Redis ────────────────────────────────────────────────────────────────────────
# local: 선택사항 (미설정 시 인메모리 폴백)
REDIS_URL=
# dev+: REDIS_URL=redis://redis:6379/0

# ── Rust risk-engine ──────────────────────────────────────────────────────────────
ENV=local
RISK_ENGINE_PORT=3001

# ── 포트 (docker-compose 호스트 포트 매핑) ────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
ANALYSIS_PORT=8001
RAG_PORT=8002
INGEST_PORT=8003
AGENTS_PORT=8004
BFF_PORT=3002
DASHBOARD_PORT=3000

# ── 브라우저 접근 URL ─────────────────────────────────────────────────────────────
# local 직접실행: localhost 직접 접근
NEXT_PUBLIC_BFF_URL=http://localhost:3002
NEXT_PUBLIC_RISK_ENGINE_URL=http://localhost:3001
# dev/staging/prod (Docker Compose): 상대경로 → Next.js rewrites() 프록시
# NEXT_PUBLIC_BFF_URL=/bff
# NEXT_PUBLIC_RISK_ENGINE_URL=/bff

# ── 서비스 내부 URL ────────────────────────────────────────────────────────────────
# ⚠️  Docker Compose env_file은 ${VAR} 미확장 → 하드코딩 필수
# local (직접실행 — localhost):
ANALYSIS_URL=http://localhost:8001
RAG_URL=http://localhost:8002
INGEST_URL=http://localhost:8003
AGENTS_URL=http://localhost:8004
RISK_ENGINE_URL=http://localhost:3001
BFF_URL=http://localhost:3002
# dev/staging/prod (Docker Compose 컨테이너 내부 통신 — 서비스명):
# ANALYSIS_URL=http://analysis:8001
# RAG_URL=http://rag:8002
# INGEST_URL=http://ingest:8003
# AGENTS_URL=http://agents:8004
# RISK_ENGINE_URL=http://risk-engine:3001
# BFF_URL=http://bff:3002

# ── 시크릿 (OS Keychain / Vault — 이 파일에 실 키 절대 기재 금지) ─────────────────
# 증권사 API
# BROKER_API_KEY=<vault-or-keychain>
# BROKER_API_SECRET=<vault-or-keychain>
# BROKER_WS_URL=wss://<broker-host>/ws

# LLM API
# ANTHROPIC_API_KEY=<vault-or-keychain>

# Auth JWT 서명 시크릿 (web/apps/dashboard — Next.js Route Handlers)
# 발급 방법:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# macOS Keychain 저장:
#   security add-generic-password -a stock-trader -s AUTH_JWT_SECRET -w "$(openssl rand -base64 32)"
# Keychain 읽기:
#   security find-generic-password -a stock-trader -s AUTH_JWT_SECRET -w
AUTH_JWT_SECRET=<change-me>
