# stock-trader — 환경 변수 예시 (커밋용 템플릿, 실 값 절대 기재 금지)
# 사용법: cp .env.example .env.local  →  실 값 채우기
APP_ENV=local

# ── DB ───────────────────────────────────────────────────────────────────────────
# local: sqlite (compose 없이 직접실행)
DATABASE_URL=sqlite:///./local.db
DATABASE_URL_SYNC=sqlite:///./local.db
# dev+: postgres
# DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/stock_trader
# DATABASE_URL_SYNC=postgresql://app:app@postgres:5432/stock_trader
POSTGRES_USER=app
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=stock_trader

# ── Redis (멱등키 · 인메모리 큐) ────────────────────────────────────────────────
REDIS_URL=
# dev+: REDIS_URL=redis://redis:6379/0

# ── Rust risk-engine ─────────────────────────────────────────────────────────────
ENV=local
RISK_ENGINE_PORT=3001

# ── 포트 (docker-compose 호스트 포트 매핑) ────────────────────────────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
ANALYSIS_PORT=8001
RAG_PORT=8002
INGEST_PORT=8003
AGENTS_PORT=8004
BFF_PORT=3002
DASHBOARD_PORT=3000

# ── Web (브라우저 접근 URL) ────────────────────────────────────────────────────────
# local/직접실행: localhost 유지
# Docker Compose 원격 서버 배포 시: 서버 IP/도메인으로 변경 (포트 포함)
#   예: NEXT_PUBLIC_BFF_URL=http://192.168.1.100:${BFF_PORT}
# staging/prod K8s: 도메인 전체 URL 지정
#   예: NEXT_PUBLIC_BFF_URL=https://bff.example.com
NEXT_PUBLIC_BFF_URL=http://localhost:${BFF_PORT}
NEXT_PUBLIC_RISK_ENGINE_URL=http://localhost:${RISK_ENGINE_PORT}

# ── 서비스 내부 URL ────────────────────────────────────────────────────────────────
# local (직접실행): localhost 사용
ANALYSIS_URL=http://localhost:${ANALYSIS_PORT}
RAG_URL=http://localhost:${RAG_PORT}
INGEST_URL=http://localhost:${INGEST_PORT}
RISK_ENGINE_URL=http://localhost:${RISK_ENGINE_PORT}
AGENTS_URL=http://localhost:${AGENTS_PORT}
BFF_URL=http://localhost:${BFF_PORT}
# dev/staging/prod (Docker Compose): 서비스명 사용 (컨테이너 내부 통신)
# ANALYSIS_URL=http://analysis:${ANALYSIS_PORT}
# RAG_URL=http://rag:${RAG_PORT}
# INGEST_URL=http://ingest:${INGEST_PORT}
# RISK_ENGINE_URL=http://risk-engine:${RISK_ENGINE_PORT}
# AGENTS_URL=http://agents:${AGENTS_PORT}
# BFF_URL=http://bff:${BFF_PORT}

# ── 증권사 API (OS Keychain 또는 Vault — 이 파일에 실 키 절대 기재 금지) ──────────
# BROKER_API_KEY=<vault-or-keychain>
# BROKER_API_SECRET=<vault-or-keychain>
# BROKER_WS_URL=wss://<broker-host>/ws

# ── LLM API (OS Keychain 또는 Vault — 이 파일에 실 키 절대 기재 금지) ────────────
# ANTHROPIC_API_KEY=<vault-or-keychain>

# ── Auth JWT 서명 시크릿 (web/apps/dashboard — Next.js Route Handlers) ───────────
# ⚠️  이 파일에 실 키 절대 기재 금지 — OS Keychain 또는 Vault 주입
# 발급 방법:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# macOS Keychain 저장:
#   security add-generic-password -a stock-trader -s AUTH_JWT_SECRET -w "$(openssl rand -base64 32)"
# Keychain 읽기:
#   security find-generic-password -a stock-trader -s AUTH_JWT_SECRET -w
AUTH_JWT_SECRET=<vault-or-keychain>
